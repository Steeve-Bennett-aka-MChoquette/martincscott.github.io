---
// Root index - instant redirect to default locale
// Using HTML redirect instead of Astro.redirect() for GitHub Pages compatibility
---
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Martin C Scott</title>
  <meta http-equiv="refresh" content="0;url=/fr/">
  <link rel="canonical" href="https://static.martincscott.com/fr/">
  <meta name="robots" content="noindex">
  <script is:inline>window.location.replace('/fr/');</script>
</head>
<body>
  <a href="/fr/">Redirecting...</a>
</body>
</html>
